# ─── Telegram ────────────────────────────────────────────────
# Bot token — @BotFather → /newbot
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin Telegram ID lar (vergul bilan ajratilgan) — kunlik hisobot oluvchilar
ADMIN_IDS=123456789

# ─── MoySklad ────────────────────────────────────────────────
# Bearer token — МойСклад → Настройки → Пользователи → Ключи доступа
MOYSKLAD_TOKEN=your_moysklad_bearer_token_here

# ─── Webhook server ──────────────────────────────────────────
# Tashqi (HTTPS) URL — MoySklad shu manzilga POST qiladi.
# Domen yoki sslip.io (masalan: https://1-2-3-4.sslip.io)
WEBHOOK_HOST=https://yourdomain.com
WEBHOOK_PATH=/moysklad/webhook
WEBHOOK_PORT=8080

# Webhook so'rovlarini tekshirish uchun maxfiy kalit (BO'SH QOLDIRMANG!)
# Generatsiya: openssl rand -hex 24
WEBHOOK_SECRET=change_me_to_random_string

# Tashqi (host) port — Traefik orqali ishlatsangiz BO'SH qoldiring.
# Faqat to'g'ridan-to'g'ri IP:port kerak bo'lsa: WEBHOOK_HOST_PORT=8081
# WEBHOOK_HOST_PORT=

# ─── Ma'lumotlar bazasi ─────────────────────────────────────
# Docker da bot_data volume ga yo'naltirilishi shart, aks holda restart da yo'qoladi
DB_PATH=/data/comfort_bot.db

# ─── Vaqt zonasi va hisobot ─────────────────────────────────
APP_TIMEZONE=Asia/Tashkent
# Kunlik hisobot vaqti (Asia/Tashkent), default 20:00
# DAILY_REPORT_HOUR=20
# DAILY_REPORT_MINUTE=0

# ─── Brending ───────────────────────────────────────────────
COMPANY_PHONE=+998958220000

# ─── Tuning (ixtiyoriy) ─────────────────────────────────────
# MoySklad enrich parallelizm (1–16, default 6)
# MOYSKLAD_ENRICH_CONCURRENCY=6
# Webhook workerlar (kichik VPS uchun: 2–3, default 3)
# WEBHOOK_WORKERS=3
# Har bir hujjat momenti uchun INFO log
# MS_MOMENT_LOG=1
# MoySklad moment offset siz kelsa qanday tz ga aylantirish (default Europe/Moscow)
# MOYSKLAD_MOMENT_NAIVE_SOURCE_TZ=Europe/Moscow
