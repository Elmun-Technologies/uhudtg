# =============================================================================
#  OY - Comfort Bot — environment configuration
#  Copy this file to ".env" (same folder) and fill in the REAL values.
#  The root docker-compose.yml reads this file via `env_file: .env`.
#  NEVER commit the real .env (it is gitignored).
# =============================================================================

# ── Telegram ─────────────────────────────────────────────────────────────────
# Bot token from @BotFather (/newbot, or /token to reissue for an existing bot)
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram IDs of admins (comma-separated). Look yours up via @userinfobot.
# Admins can broadcast messages and receive the daily report.
ADMIN_IDS=123456789

# ── MoySklad (ERP) ───────────────────────────────────────────────────────────
# MoySklad API Bearer token.
# Get it: МойСклад → Настройки → Пользователи → <user> → Ключи доступа
MOYSKLAD_TOKEN=your_moysklad_bearer_token_here

# UUID of the custom "Telegram ID" attribute on the counterparty entity.
# ACCOUNT-SPECIFIC — differs per MoySklad account. Find the correct value with:
#   docker compose exec bot python list_attributes.py
# Leave blank to create new counterparties without the attribute (bot still works,
# but restore_users.py can no longer rebuild the users table from MoySklad).
MOYSKLAD_TG_ATTR_UUID=

# ── Public domain / webhook ──────────────────────────────────────────────────
# Domain that resolves (via DNS A record) to THIS server's public IP.
# Consumed by Caddy (Caddyfile uses {$DOMAIN}) to obtain the Let's Encrypt cert.
DOMAIN=yourdomain.com

# Public HTTPS base URL used when registering MoySklad webhooks. Normally
# https://<DOMAIN>. Must match DOMAIN above.
WEBHOOK_HOST=https://yourdomain.com
WEBHOOK_PATH=/moysklad/webhook
WEBHOOK_PORT=8080

# Secret appended to the webhook URL (?secret=...) and validated on every
# incoming webhook. Use a long random string:  openssl rand -hex 24
# NOTE: this value is NOT recoverable if lost — pick a new one and re-register
# webhooks (cleanup_webhooks.py + register_webhooks.py).
WEBHOOK_SECRET=change_me_to_random_string

# Optional: expose the bot's 8080 directly on the host (only if NOT using Caddy,
# or if 8080 is free and you want a direct IP:port). Leave blank to keep it
# internal and serve HTTPS through Caddy (recommended).
# WEBHOOK_HOST_PORT=

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite path. In Docker this MUST point at the mounted volume (/data), otherwise
# the DB lives in the container's writable layer and is wiped on every rebuild
# (all registered users would be lost and would need to /start again).
DB_PATH=/data/comfort_bot.db

# ── Bot appearance / behaviour ───────────────────────────────────────────────
# Company phone shown in the bot description
COMPANY_PHONE=+998958220000

# IANA timezone for the bot's "now", calendars and report boundaries
APP_TIMEZONE=Asia/Tashkent

# Daily report time (Asia/Tashkent), defaults 20:00
# DAILY_REPORT_HOUR=20
# DAILY_REPORT_MINUTE=0

# ── Advanced / optional tuning ───────────────────────────────────────────────
# 1 = log every MoySklad document moment (raw → stored). Debug only.
# MS_MOMENT_LOG=1

# MoySklad returns `moment` without offset (treated as Europe/Moscow, UTC+3) and
# the bot converts it to APP_TIMEZONE. Set to "none" to disable conversion.
# MOYSKLAD_MOMENT_NAIVE_SOURCE_TZ=Europe/Moscow

# Parallel enrich requests when listing shipments (1–16, default 6)
# MOYSKLAD_ENRICH_CONCURRENCY=6

# Webhook worker count (small VPS: 2–3, default 3)
# WEBHOOK_WORKERS=3
